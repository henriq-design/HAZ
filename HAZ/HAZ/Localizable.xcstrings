    "permission.required.title": {
      "comment": "Interfaz HAZ. Revisar zh-Hans antes de publicar.",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lupa y Área x2/x3 necesitan Grabación de pantalla"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Magnifier and Area x2/x3 need Screen Recording"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "放大镜和区域 x2/x3 需要屏幕录制权限"
          }
        }
      }
    },
    "permission.required.body": {
      "comment": "Interfaz HAZ. Revisar zh-Hans antes de publicar.",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "HAZ solo necesita capturar la pantalla al usar Lupa o ampliar un Área a x2/x3. Concede acceso en Privacidad y seguridad > Grabación de pantalla y audio del sistema. Área x1 y sus Guías seguirán funcionando sin este permiso."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "HAZ only needs to capture the screen when using Magnifier or enlarging an Area to x2/x3. Allow access in Privacy & Security > Screen & System Audio Recording. Area x1 and its Guides will keep working without this permission."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只有使用放大镜或将区域放大到 x2/x3 时，HAZ 才需要捕获屏幕。请在“隐私与安全性 > 屏幕与系统音频录制”中允许访问。区域 x1 及其辅助线无需此权限仍可使用。"
          }
        }
      }
    },
    "permission.captureFailed.title": {
      "comment": "Interfaz HAZ. Revisar zh-Hans antes de publicar.",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "HAZ no puede capturar esta pantalla"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "HAZ can’t capture this display"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "HAZ 无法捕获此显示器"
          }
        }
      }
    },
    "permission.captureFailed.grantedBody": {
      "comment": "Interfaz HAZ. Revisar zh-Hans antes de publicar.",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS indica que HAZ tiene permiso, pero ScreenCaptureKit no ha podido iniciar la captura necesaria para Lupa o Área x2/x3. Usa «Revisar captura y permiso…» para habilitar un nuevo intento o cierra y vuelve a abrir HAZ."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS says HAZ has permission, but ScreenCaptureKit could not start the capture required by Magnifier or Area x2/x3. Use “Review capture and access…” to enable another attempt, or quit and reopen HAZ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 显示 HAZ 已获授权，但 ScreenCaptureKit 无法启动放大镜或区域 x2/x3 所需的捕获。请使用“检查捕获与权限…”重新尝试，或退出并重新打开 HAZ。"
          }
        }
      }
    },
    "permission.captureFailed.deniedBody": {
      "comment": "Interfaz HAZ. Revisar zh-Hans antes de publicar.",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS está rechazando Grabación de pantalla para esta compilación. Lupa y Área x2/x3 no podrán ampliar contenido hasta que habilites HAZ en Ajustes y vuelvas a abrir la app."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS is denying Screen Recording for this build. Magnifier and Area x2/x3 cannot enlarge content until you allow HAZ in Settings and reopen the app."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 正在拒绝此版本的屏幕录制权限。在“设置”中允许 HAZ 并重新打开应用之前，放大镜和区域 x2/x3 无法放大内容。"
          }
        }
      }
    },
