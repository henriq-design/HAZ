{
  "sourceLanguage": "es",
  "strings": {
    "brand.claim": {
      "comment": "Propuesta de localización; revisar zh-Hans antes de publicar.",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Foco donde importa."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Focus where it matters."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "聚焦重要之处。"
          }
        }
      }
    },
    "hero.current": {
      "comment": "Propuesta de localización; revisar zh-Hans antes de publicar.",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Amplía interfaces y dirige la atención sin perder el contexto."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Magnify interfaces and guide attention without losing context."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "放大界面，突出重点，同时保留上下文。"
          }
        }
      }
    },
    "hero.future": {
      "comment": "Propuesta de localización; revisar zh-Hans antes de publicar.",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Señala, amplía y revisa interfaces sin perder el contexto."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Highlight, magnify and review interfaces without losing context."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "突出重点、放大并查看界面，同时保留上下文。"
          }
        }
      }
    },
