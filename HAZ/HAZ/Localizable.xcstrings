    "onboarding.permission.body": {
      "comment": "Onboarding HAZ. Revisar zh-Hans antes de publicar.",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lupa y Área x2/x3 necesitan Grabación de pantalla para ampliar contenido de otras apps. HAZ solo captura mientras estas herramientas están activas. Área x1 y Guías funcionan sin este permiso."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Magnifier and Area x2/x3 need Screen Recording to magnify content from other apps. HAZ only captures while those tools are active. Area x1 and Guides work without this permission."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "放大镜和区域 x2/x3 需要“屏幕录制”权限才能放大其他应用的内容。HAZ 只会在这些工具启用时进行捕获。区域 x1 和参考线无需此权限即可使用。"
          }
        }
      }
    },
    "onboarding.permission.granted": {
      "comment": "Onboarding HAZ. Revisar zh-Hans antes de publicar.",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Acceso a Grabación de pantalla concedido"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Screen Recording access granted"
